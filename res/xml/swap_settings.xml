<!-- All values live in system properties (see SwapSettings.java), so
     nothing here is persisted in shared preferences. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/swap_settings_title">

    <SwitchPreference
        android:key="swap_enabled"
        android:title="@string/swap_enabled_title"
        android:summary="@string/swap_enabled_summary"
        android:persistent="false" />

    <DropDownPreference
        android:key="swap_mode"
        android:title="@string/swap_mode_title"
        android:entries="@array/swap_mode_entries"
        android:entryValues="@array/swap_mode_values"
        android:summary="%s"
        android:persistent="false" />

    <DropDownPreference
        android:key="swap_order"
        android:title="@string/swap_order_title"
        android:entries="@array/swap_order_entries"
        android:entryValues="@array/swap_order_values"
        android:summary="%s"
        android:persistent="false" />

    <DropDownPreference
        android:key="swap_zram_size"
        android:title="@string/swap_zram_size_title"
        android:entries="@array/swap_zram_size_entries"
        android:entryValues="@array/swap_zram_size_values"
        android:summary="%s"
        android:persistent="false" />

    <DropDownPreference
        android:key="swap_reclaim"
        android:title="@string/swap_reclaim_title"
        android:entries="@array/swap_reclaim_entries"
        android:entryValues="@array/swap_reclaim_values"
        android:summary="%s"
        android:persistent="false" />

    <DropDownPreference
        android:key="swap_swappiness"
        android:title="@string/swap_swappiness_title"
        android:entries="@array/swap_swappiness_entries"
        android:entryValues="@array/swap_swappiness_values"
        android:summary="%s"
        android:persistent="false" />

    <Preference
        android:key="swap_status"
        android:title="@string/swap_status_title"
        android:selectable="false"
        android:persistent="false" />

    <Preference
        android:key="swap_sdcard_warning"
        android:summary="@string/swap_sdcard_warning"
        android:selectable="false"
        android:persistent="false" />

</PreferenceScreen>
